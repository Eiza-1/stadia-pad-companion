{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pad Companion",
  "version": "0.1.0",
  "identifier": "com.padcompanion.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Pad Companion",
    "shortDescription": "Stadia controller companion",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "Pad Companion contributors"
  }
}
